{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Loom",
  "version": "0.1.0",
  "identifier": "ai.skillloom.desktop",
  "build": {
    "frontendDist": "../panel/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Loom",
        "url": "team.html",
        "width": 1180,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "externalBin": [
      "binaries/loom"
    ],
    "icon": [
      "icons/icon.png"
    ]
  }
}
